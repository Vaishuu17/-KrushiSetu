{
  "version": 2,
  "builds": [
    {
      "src": "Final Project/server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Final Project/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Final Project/server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "Final Project/client/index.html"
    }
  ]
}
